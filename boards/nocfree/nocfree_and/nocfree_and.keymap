#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * ISO map, for a host set to a German (or any other) national ISO layout.
 *
 * HID keycodes are positional: the host's layout decides which character a
 * position produces. So this is *not* a German keymap -- it is the standard
 * positional map plus the two codes ANSI does not have, and a host set to
 * German turns it into a German keyboard. Set the layout in the operating
 * system, not here.
 *
 *   NON_US_BSLH  the key between LSHFT and Z   -> DE  < > |
 *   NON_US_HASH  the key left of the ISO Enter -> DE  # '
 *
 * Bindings are listed in visual reading order. Each line pair is one physical
 * row: the left half first, then the right half.
 *
 * The bottom row is the owner's own arrangement, carried over from what they
 * had configured in NocFree Link: Control outermost on the left with Fn beside
 * it, and AltGr immediately right of the space bar with Control outboard of Fn.
 * It deliberately differs from the factory map (which reads Fn / Control /
 * Option / Command from the outside in).
 *
 * Backlight brightness is set to absolute levels, never stepped. ZMK relays the
 * backlight behaviour to the peripheral (BEHAVIOR_LOCALITY_GLOBAL) but never
 * synchronises the resulting state: each half keeps its own brightness in its
 * own NVS, so BL_INC/BL_DEC add a relative step to whatever that half happens
 * to hold, and one relay lost to a split-link hiccup leaves a permanent offset
 * that survives reboots. BL_SET lands both halves on the same number.
 */

/ {
    /*
     * Recovery key. Tap resets the half; hold for 1.5 s drops it into its
     * preserved UF2 bootloader. ZMK reset behaviours act on the half whose
     * key triggered them, so this behaviour is placed once on each half:
     * Fn+Esc on the left, Fn+Delete on the right.
     *
     * A hold-tap always passes two parameters to its bound behaviours.
     * &bootloader and &sys_reset take none, so every use passes two zeroes.
     *
     * tap-preferred: a quick tap is a reset even if the key is still held
     * when the next one arrives. Only a deliberate 1.5 s hold reaches the
     * bootloader.
     */
    behaviors {
        /*
         * Types the battery percentage out as "bat NN". The factory firmware
         * did this on Fn+i and this keeps that muscle memory.
         *
         * It has to be a behaviour rather than a macro: macros send a fixed
         * sequence, and the percentage is a runtime value. Output is digits,
         * letters and space only -- those sit in the same places on ANSI and
         * German ISO, punctuation does not. See docs/battery.md.
         */
        batt_report: battery_report {
            compatible = "nocfree,behavior-battery-report";
            #binding-cells = <0>;
            display-name = "Battery";
        };

        boot_reset: bootloader_or_reset {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&bootloader>, <&sys_reset>;
            tapping-term-ms = <1500>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp F1    &kp F2    &kp F3    &kp F4    &bl BL_SET 0 &bl BL_SET 100
                &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp PSCRN &none

                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6
                &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp HOME

                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp END

                &kp CAPS  &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp NON_US_HASH &kp RET

                &kp LSHFT &kp NON_US_BSLH &kp Z &kp X   &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP    &kp DEL

                &kp LCTRL &mo 1     &kp LGUI  &kp LALT  &kp SPACE
                &kp SPACE &kp RALT  &mo 1     &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        /*
         * Function layer.
         *
         *   Fn+1..Fn+5   select Bluetooth profile 0..4
         *   Fn+0         clear the selected Bluetooth profile
         *   Fn+U         send HID over USB
         *   Fn+i         type the battery level as "bat NN"
         *   Fn+B         send HID over Bluetooth
         *   Fn+F5..F12   the real F5..F12 (the base layer carries the
         *                owner's media and backlight functions there instead)
         *   Fn+Home      Page Up      Fn+End      Page Down
         *   Fn+F10/11/12 mute, volume down, volume up
         *   Fn+Esc       tap: reset the left half   hold 1.5 s: its bootloader
         *   Fn+Delete    tap: reset the right half  hold 1.5 s: its bootloader
         *
         * ZMK reset behaviours act on the half whose key triggered them: Esc
         * is a left-half key and Delete a right-half one. On ISO, Delete sits
         * at the end of the shift row rather than the home row. Fn+Delete
         * needs the split link up to reach the right half. Either half can
         * always be recovered over its USB CDC interface instead; see
         * docs/recovery.md.
         */
        function_layer {
            display-name = "Fn";
            bindings = <
                &boot_reset 0 0 &trans &trans     &trans     &trans     &kp F5     &kp F6
                &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12    &trans     &trans

                &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans     &trans     &trans     &bt BT_CLR &trans     &trans     &trans     &kp PG_UP

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &out OUT_USB &batt_report &trans   &trans     &trans     &trans     &kp PG_DN

                &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans     &out OUT_BLE
                &trans     &trans     &trans     &trans     &trans     &trans     &trans  &boot_reset 0 0

                &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
