CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_I2C=y

# Link and flash only into the preserved application slot.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Settings live in the dedicated NVS partition, clear of the factory filesystem.
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Warm-reset request into the preserved Adafruit UF2 bootloader.
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# Use the internal RC oscillator for the 32.768 kHz clock. This port has not
# confirmed that a 32.768 kHz crystal is fitted, and selecting a crystal that is
# not present prevents the Bluetooth controller from starting. RC is accurate
# enough for BLE once calibrated. See docs/architecture.md.
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y

# Host-facing outputs. The left half is the split central.
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# Battery measurement on this half. The divider node is in the board .dts;
# see the comment there for the pins and for why the reading is uncalibrated.
#
# This is step 1 of the battery plan: establish that the ADC reads something
# that tracks charge and discharge. Over USB the value is invisible to a host
# (USB HID has no battery channel), so it is read over BLE or, later, typed out
# by a dedicated behaviour.
CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_ADC=y
CONFIG_SENSOR=y

# USB CDC interface used only for 1200-baud bootloader recovery.
CONFIG_SERIAL=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_CDC_ACM=y
CONFIG_CDC_ACM_DTE_RATE_CALLBACK_SUPPORT=y

# Keep every BLE link on the 1M PHY. Both radios also support the optional
# 2M PHY and Zephyr upgrades to it automatically, but 2M trades several dB of
# receive sensitivity for throughput this keyboard does not need, and that
# margin is what the split link lives on at desk distances. At the pinned ZMK
# revision this option's only effect is disabling the controller's 2M PHY, so
# neither the split link nor the host link can negotiate away from 1M.
# Transmit power is unchanged: this alters how the radio listens, not how
# loudly it talks.
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y

# When the link fades, un-acknowledged packets pile up inside the Bluetooth
# stack. With the default three TX buffers that pile-up immediately makes
# notification submission fail, and ZMK's split code drops the key state it
# was about to send (the state is dequeued before bt_gatt_notify() and a
# failure is only logged). More buffers keep submissions succeeding across a
# longer fade, for a few hundred bytes of RAM.
CONFIG_BT_BUF_ACL_TX_COUNT=8
CONFIG_BT_L2CAP_TX_BUF_COUNT=8
CONFIG_BT_CONN_TX_MAX=8

# Queue of per-position events received from the peripheral. This is also the
# queue that absorbs the release-everything burst raised when a peripheral
# disconnects; the default of 5 silently drops releases beyond it if more
# keys are held at that moment.
CONFIG_ZMK_SPLIT_BLE_CENTRAL_POSITION_QUEUE_SIZE=16

# Backlight on P0.20 via PWM, the pin published as D5 in section 4 of the
# porting guide; see docs/backlight.md. It starts OFF: the polarity is taken
# from documentation and from the factory image, not from a measurement, and
# a wrong reading must not be able to sit at full brightness on battery.
# Switch it on with Fn+F7.
# ZMK's backlight does not select its own driver stack at the pinned
# revision, so the PWM LED driver has to be enabled here or the pwmleds node
# is never instantiated and backlight.c fails to link.
CONFIG_PWM=y
CONFIG_LED=y
CONFIG_LED_PWM=y
CONFIG_ZMK_BACKLIGHT=y
CONFIG_ZMK_BACKLIGHT_BRT_START=40
CONFIG_ZMK_BACKLIGHT_ON_START=n
CONFIG_ZMK_BACKLIGHT_AUTO_OFF_IDLE=y

# The backlight follows ZMK's idle state, and ZMK's default idle timeout is
# 30 seconds -- far too short for a backlight the owner wants lit while
# reading. 60 minutes. The cost is that ZMK stays in its active BLE mode that
# much longer, with the shorter connection interval that goes with it.
CONFIG_ZMK_IDLE_TIMEOUT=3600000
