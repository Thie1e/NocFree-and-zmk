CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_I2C=y

# Link and flash only into the preserved application slot.
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Settings live in the dedicated NVS partition, clear of the factory filesystem.
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Warm-reset request into the preserved Adafruit UF2 bootloader.
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# See the left defconfig for why the internal RC oscillator is used.
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y

# The right half is a split peripheral: it has no host-facing HID output.
CONFIG_ZMK_BLE=y

# No battery source is declared: the ADC and divider-enable pins are not
# verified by this port. Reporting would otherwise default on and advertise a
# Battery Service with nothing behind it.
CONFIG_ZMK_BATTERY_REPORTING=n

# USB is brought up only for the CDC recovery interface, so this half keeps a
# host-driven bootloader path that does not depend on the split link -- the one
# route that still works when this half cannot pair with the central.
# Fn+Delete does reach this half's bootloader (confirmed on hardware), but only
# while it is connected to the central AND cabled to USB itself: the bootloader
# presents a mass-storage device, which needs a host to enumerate to.
# See docs/recovery.md.
# With CONFIG_ZMK_USB unset ZMK never calls usb_enable(), so
# INITIALIZE_AT_BOOT is the line that actually enumerates USB here.
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_INITIALIZE_AT_BOOT=y
CONFIG_SERIAL=y
CONFIG_UART_LINE_CTRL=y
CONFIG_USB_CDC_ACM=y
CONFIG_CDC_ACM_DTE_RATE_CALLBACK_SUPPORT=y

# Keep the split link on the 1M PHY; see the left defconfig for the full
# rationale. Set on both halves so neither side can negotiate 2M.
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y

# Deeper BLE TX pipeline. This half is where the known ZMK gap bites: the
# split peripheral dequeues a complete key-state bitmap before calling
# bt_gatt_notify(), and if submission fails (all TX buffers occupied by
# packets awaiting retransmission over a marginal link) that state is dropped
# with only a debug log. A dropped final release leaves the central holding a
# stale key until the next key event from this half. More buffers mean the
# stack keeps accepting states across a longer fade and delivers them when
# the link recovers.
CONFIG_BT_BUF_ACL_TX_COUNT=8
CONFIG_BT_L2CAP_TX_BUF_COUNT=8
CONFIG_BT_CONN_TX_MAX=8

# Queue of complete 16-byte key-state bitmaps awaiting transmission to the
# central. Overflow discards the oldest entry, so the newest state always
# survives and the link converges to the true state on recovery; a deeper
# queue widens the window in which no intermediate keystroke is lost.
# 32 entries x 16 B = 512 B of RAM.
CONFIG_ZMK_SPLIT_BLE_PERIPHERAL_POSITION_QUEUE_SIZE=32

# Backlight on P0.20 via PWM, the pin published as D5 in section 4 of the
# porting guide; see docs/backlight.md. It starts OFF: the polarity is taken
# from documentation and from the factory image, not from a measurement, and
# a wrong reading must not be able to sit at full brightness on battery.
# Switch it on with Fn+F7.
# ZMK's backlight does not select its own driver stack at the pinned
# revision, so the PWM LED driver has to be enabled here or the pwmleds node
# is never instantiated and backlight.c fails to link.
CONFIG_PWM=y
CONFIG_LED=y
CONFIG_LED_PWM=y
CONFIG_ZMK_BACKLIGHT=y
CONFIG_ZMK_BACKLIGHT_BRT_START=40
CONFIG_ZMK_BACKLIGHT_ON_START=n
CONFIG_ZMK_BACKLIGHT_AUTO_OFF_IDLE=y

# The backlight follows ZMK's idle state, and ZMK's default idle timeout is
# 30 seconds -- far too short for a backlight the owner wants lit while
# reading. 60 minutes. The cost is that ZMK stays in its active BLE mode that
# much longer, with the shorter connection interval that goes with it.
CONFIG_ZMK_IDLE_TIMEOUT=3600000
